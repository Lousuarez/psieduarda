# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados reais.
# Esse arquivo não vem no repositório de propósito — nunca deve ser enviado
# ao GitHub, pois guarda credenciais de verdade.

PORT=3000
NODE_ENV=development

# Em hPanel > Bancos de dados > Bancos de dados MySQL, o host quase sempre é
# "localhost". O nome do banco e do usuário na Hostinger costumam vir com um
# prefixo, ex: u123456789_juntos
DB_HOST=localhost
DB_PORT=3306
DB_USER=SEU_USUARIO_MYSQL
DB_PASS=SUA_SENHA_MYSQL
DB_NAME=SEU_BANCO

# O login (usuário/senha do painel) não vem mais de variável de ambiente —
# fica na tabela "users" do próprio banco, já criada com um usuário "Admin"
# padrão pelo schema.sql. Veja o README para trocar a senha ou criar outros
# usuários.
