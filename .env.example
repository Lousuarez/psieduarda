# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados reais.
# Esse arquivo não vem no repositório de propósito — nunca deve ser enviado
# ao GitHub, pois guarda credenciais de verdade.

PORT=3000
NODE_ENV=development

# Em hPanel > Bancos de dados > Bancos de dados MySQL, o host quase sempre é
# "localhost". O nome do banco e do usuário na Hostinger costumam vir com um
# prefixo, ex: u123456789_juntos
DB_HOST=localhost
DB_PORT=3306
DB_USER=SEU_USUARIO_MYSQL
DB_PASS=SUA_SENHA_MYSQL
DB_NAME=SEU_BANCO

# Chave usada para assinar o cookie de sessão — qualquer string longa e
# aleatória. Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque_por_uma_string_aleatoria_longa

# Usuário e senha de acesso ao painel administrativo da ferramenta.
# Para gerar o hash de uma senha nova, rode no terminal:
# node -e "console.log(require('bcryptjs').hashSync('sua_nova_senha', 10))"
ADMIN_USER=Admin
ADMIN_PASS_HASH=$2a$10$substitua_por_um_hash_bcrypt_gerado_pelo_comando_acima
