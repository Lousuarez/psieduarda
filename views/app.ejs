async function exportEstadoAtual(){
  toast('Gerando planilha…');
  try{
    const res = await fetch('api/export', { headers: authHeaders() });
    if(!res.ok){ toast('Não foi possível exportar'); return; }
    const blob = await res.blob();
    const disposition = res.headers.get('Content-Disposition') || '';
    const match = disposition.match(/filename="([^"]+)"/);
    const filename = match ? match[1] : 'juntos-a-distancia.xlsx';
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    toast('Planilha baixada');
  }catch(e){ toast('Não foi possível exportar'); }
}
async function generateColabLink(){
  if(!editingColabId){ toast('Salve o colaborador antes de gerar o link'); return; }
  const res = await fetch('api/colaboradores/'+encodeURIComponent(editingColabId)+'/link', { method:'POST', headers: authHeaders() });
  if(!res.ok){ toast('Não foi possível gerar o link'); return; }
  const data = await res.json();
  const url = location.origin + '/minha-trilha/' + data.token;
  document.getElementById('cf-link-value').value = url;
  document.getElementById('cf-link-copy-btn').style.display = '';
  const c = colaboradores.find(x=>x.id===editingColabId);
  if(c) c.hasAccessToken = true;
  toast('Link gerado');
}
function copyColabLink(){
  const input = document.getElementById('cf-link-value');
  input.select();
  if(navigator.clipboard?.writeText){
    navigator.clipboard.writeText(input.value).then(()=>toast('Link copiado')).catch(()=>toast('Não foi possível copiar automaticamente'));
  } else {
    document.execCommand('copy'); toast('Link copiado');
  }
}
function askDeleteColab(){
