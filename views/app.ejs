    if(currentTab==='unidades') renderUnidades();
    if(currentTab==='usuarios') renderUsuarios();
  } else if(currentMode==='reports'){
    if(currentTab==='frequencia') renderRelatorioFrequencia(document.getElementById('relfreq-search')?.value);
    if(currentTab==='frequenciaColab') renderRelfreqColabView(document.getElementById('relfreqcolab-search')?.value);
    if(currentTab==='auditoria') renderAuditoriaView();
    if(currentTab==='loginLog') renderLoginLogView();
  }
  if(document.getElementById('modal-colab').classList.contains('show')) renderColabFormTrilhas();
  if(document.getElementById('modal-module').classList.contains('show')){ renderModuleTurma(); renderModuleCronograma(); }
  populateSelects();
}

function renderDashboard(){
  const el = document.getElementById('dash-grid');
  if(!el) return;
  if(dbUnavailable){ el.innerHTML = '<p class="dash-empty">Banco de dados indisponível.</p>'; return; }
  if(!isLoaded('colaboradores') || !isLoaded('progresso') || !isLoaded('modulos') || !isLoaded('temas') || !isLoaded('ciclos')){
    el.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando…</div>'; return;
  }

  const ranking = colaboradores
    .filter(c => (c.trilhaIds||[]).length)
    .map(c => ({ c, conc: colabConclusao(c) }))
    .filter(x => x.conc.total > 0)
    .sort((a,b) => b.conc.pct - a.conc.pct)
    .slice(0, 5);
  const rankingHtml = ranking.length
    ? ranking.map((x,i) => `<div class="dash-rank-row"><span class="dash-rank-num">${i+1}º</span><span class="dash-rank-name">${esc(x.c.nome)}</span><span class="dash-rank-pct">${x.conc.pct}%</span></div>`).join('')
    : '<p class="dash-empty">Sem dados suficientes ainda.</p>';

  const categorias = ['Liderança','Método','Liderança e Método','Autoconhecimento','Inovação'];
  const catHtml = categorias.map(cat => {
    const mods = modulos.filter(m => m.categoria === cat);
    if(!mods.length) return '';
    let slots = 0, done = 0;
    mods.forEach(m => {
      const ci = cicloOfModulo(m);
      const enrolled = ci ? colaboradores.filter(c => (c.trilhaIds||[]).includes(ci.trilhaId)) : [];
      slots += enrolled.length;
      done += enrolled.filter(c => progresso.some(p=>p.colaboradorId===c.id && p.moduloId===m.id && p.status==='Concluído')).length;
    });
    const pct = slots ? Math.round(done/slots*100) : 0;
    return `<div class="dash-cat-row">
      <div class="dash-cat-head"><span>${esc(cat)}</span><span>${pct}%</span></div>
      <div class="progress-bar-outer"><div class="progress-bar-inner" style="width:${pct}%"></div></div>
    </div>`;
  }).join('');

  const now = Date.now();
  const stale = progresso
    .filter(p => p.status === 'Em andamento' && p.updatedAt)
    .map(p => ({
      c: colaboradores.find(x=>x.id===p.colaboradorId),
      m: modulos.find(x=>x.id===p.moduloId),
      days: Math.max(0, Math.floor((now - new Date(p.updatedAt).getTime()) / 86400000)),
    }))
    .filter(x => x.c && x.m)
    .sort((a,b) => b.days - a.days)
    .slice(0, 5);
  const staleHtml = stale.length
    ? stale.map(x => `<div class="dash-stale-row"><span class="dash-stale-name">${esc(x.c.nome)} · ${esc(x.m.nome)}</span><span class="dash-stale-days">${x.days===0?'hoje':x.days+'d'}</span></div>`).join('')
    : '<p class="dash-empty">Ninguém em andamento no momento.</p>';

  el.innerHTML = `
    <div class="dash-card">
      <p class="dash-card-title">Top conclusão</p>
      ${rankingHtml}
    </div>
    <div class="dash-card">
      <p class="dash-card-title">Conclusão por categoria</p>
      ${catHtml || '<p class="dash-empty">Sem módulos cadastrados ainda.</p>'}
    </div>
    <div class="dash-card">
      <p class="dash-card-title">Em andamento há mais tempo</p>
      ${staleHtml}
    </div>
  `;
}

function renderKpis(){
  const ativos = colaboradores.filter(c=>c.ativo!==false).length;
  const totalMod = modulos.length;
  let somaPct = 0, comTrilha = 0;
  colaboradores.forEach(c => { if((c.trilhaIds||[]).length){ somaPct += colabConclusao(c).pct; comTrilha++; } });
  const mediaPct = comTrilha ? Math.round(somaPct/comTrilha) : 0;
  document.getElementById('kpi-row').innerHTML = `
    <div class="kpi-card"><div class="kpi-num">${ativos}</div><div class="kpi-label">Colaboradores ativos</div></div>
