function colabEnrolledTrilhas(c){
  // Todos os módulos (agrupados por tema) dos ciclos das trilhas em que a
  // pessoa está matriculada — sem progresso registrado, o módulo aparece
  // como "Não iniciado" (ver render abaixo).
  return (c.trilhaIds||[]).map(tid=>{
    const t = trilhaById(tid); if(!t) return null;
    const ciclosComTemas = sortedCiclosOf(tid).map(ci=>{
      const temasCom = temasOf(ci.id).map(te=>({te, mods: modulosOf(te.id)})).filter(x=>x.mods.length);
      return {ci, temasCom};
    }).filter(x=>x.temasCom.length);
    return ciclosComTemas.length ? {t, ciclosComTemas} : null;
  }).filter(Boolean);
}

function renderViewColabDetail(){
  const el = document.getElementById('vcolab-detail');
  if(dbUnavailable){ el.innerHTML = '<div class="empty-state">Este visualizador não tem acesso ao banco de dados do artifact.</div>'; return; }
  const c = colaboradores.find(x=>x.id===colabSelected);
  if(!c){ el.innerHTML = '<div class="empty-state">Selecione um colaborador na lista.</div>'; return; }
  const unidadeNome = unidadeById(c.unidadeId)?.nome || '—';
  const enrolled = colabEnrolledTrilhas(c);
  const allMods = enrolled.flatMap(({ciclosComTemas})=>ciclosComTemas.flatMap(ci=>ci.temasCom.flatMap(x=>x.mods)));
  const done = allMods.filter(m=>progressoDoc(c.id,m.id)?.status==='Concluído').length;
  const pct = allMods.length ? Math.round(done/allMods.length*100) : 0;

  let html = `
    <div class="colab-head-row">
      <div>
        <h2>${esc(c.nome)}</h2>
        <div class="colab-meta-row">
          ${c.lideranca ? '<span class="badge lideranca">Liderança</span>' : ''}
          ${c.ativo===false ? '<span class="badge inativo">Inativo</span>' : ''}
          <span class="badge">${esc(unidadeNome)}</span>
          ${c.cargo ? `<span class="badge">${esc(c.cargo)}</span>` : ''}
        </div>
      </div>
      ${enrolled.length > 1 ? `<div class="colab-head-stat">
        <span class="colab-head-stat-num">${pct}%</span>
        <span class="colab-head-stat-label">${done}/${allMods.length} módulos no total</span>
      </div>` : ''}
    </div>`;
  if(c.nota){ html += `<div class="warn-box">${warnSvg()}<span>${esc(c.nota)}</span></div>`; }
  if(c.email || c.gestor || c.dataAdmissao){
    html += `<p style="font-size:12.5px;color:var(--ink-dim);margin:0 0 6px;">${[c.email, c.gestor?('gestor: '+c.gestor):'', c.dataAdmissao?('desde '+c.dataAdmissao):''].filter(Boolean).map(esc).join(' · ')}</p>`;
  }

  html += `<div class="section-h">Trilhas</div>`;
  if(!enrolled.length){
    html += `<p style="font-size:12.5px;color:var(--ink-dim);">Ainda não está inserido em nenhuma trilha.</p>`;
  } else {
    enrolled.forEach(({t, ciclosComTemas}) => {
      const modsT = ciclosComTemas.flatMap(ci=>ci.temasCom.flatMap(x=>x.mods));
      const doneT = modsT.filter(m=>progressoDoc(c.id,m.id)?.status==='Concluído').length;
      const pctT = modsT.length ? Math.round(doneT/modsT.length*100) : 0;
      html += `<div class="progress-group">
        <div class="progress-group-title">${esc(t.nome)}</div>
        <div class="progress-group-stat-row">
          <span class="progress-group-stat-num">${pctT}%</span>
          <span class="progress-group-stat-label">${doneT}/${modsT.length} módulos concluídos</span>
        </div>
        <div class="progress-bar-outer"><div class="progress-bar-inner" style="width:${pctT}%"></div></div>`;
      ciclosComTemas.forEach(({ci, temasCom}) => {
        const mods = temasCom.flatMap(x=>x.mods);
        const doneCi = mods.filter(m=>progressoDoc(c.id,m.id)?.status==='Concluído').length;
        const pctCi = mods.length ? Math.round(doneCi/mods.length*100) : 0;
        html += `<div class="progress-cycle-card">
          <div class="progress-cycle-head">
            <span class="progress-cycle-title">${esc(ci.nome)}</span>
            <span class="progress-cycle-count">${doneCi}/${mods.length}</span>
          </div>
          <div class="progress-bar-outer progress-bar-outer-sm"><div class="progress-bar-inner" style="width:${pctCi}%"></div></div>`;
        temasCom.forEach(({te, mods: modsTe}) => {
          const withStatus = modsTe.map(m => ({m, st: progressoDoc(c.id, m.id)?.status || 'Não iniciado'}));
          const emAndamento = withStatus.filter(x=>x.st==='Em andamento');
          const concluidos = withStatus.filter(x=>x.st==='Concluído');
          const naoIniciados = withStatus.filter(x=>x.st==='Não iniciado');
          const groupId = `pmore-${c.id}-${te.id}`;
          html += `<div class="progress-tema-group">
            <div class="progress-tema-head">
              <span class="progress-tema-title">${esc(te.titulo)}</span>
              <span class="progress-tema-count">${concluidos.length}/${modsTe.length}</span>
            </div>
            <div class="prog-list">`;
          [...emAndamento, ...concluidos].forEach(({m, st}) => { html += vcolabProgRow(m, st); });
          if(naoIniciados.length){
            html += `<button type="button" class="prog-toggle-more" onclick="toggleProgMore('${groupId}')" id="${groupId}-btn">+ mostrar ${naoIniciados.length} não iniciado${naoIniciados.length>1?'s':''}</button>
            <div class="prog-more-list" id="${groupId}" style="display:none">`;
            naoIniciados.forEach(({m, st}) => { html += vcolabProgRow(m, st); });
            html += `</div>`;
          }
          html += `</div></div>`;
        });
        html += `</div>`;
      });
      html += `</div>`;
    });
  }
  el.innerHTML = html;
}
