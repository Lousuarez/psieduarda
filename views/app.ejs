    <div class="kpi-card"><div class="kpi-num">${totalMod}</div><div class="kpi-label">Módulos</div></div>
    <div class="kpi-card"><div class="kpi-num">${mediaPct}%</div><div class="kpi-label">Conclusão média da trilha</div></div>
  `;
}
