/* ---------- State ---------- */
let db = null;
let unidades = [], trilhas = [], ciclos = [], temas = [], modulos = [], colaboradores = [], progresso = [], usuarios = [], moduloEtapas = [], moduloFrequencia = [], moduloChamadas = [];
