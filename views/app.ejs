  return `<div class="prog-row prog-row-sm"><span class="status-dot ${statusPillClass(st)}"></span><span class="prog-name">${esc(m.nome)}</span>
    <span class="status-pill status-pill-sm ${statusPillClass(st)}" style="pointer-events:none;">${esc(st)}</span></div>`;
}
