              <p class="window-sub">Consulte o panorama de cada colaborador — nada aqui é editável.</p>
            </div>
          </div>
          <div class="window-body">
            <div class="colab-layout">
              <div>
                <div class="colab-toolbar">
                  <input type="text" class="colab-search" id="vcolab-search" placeholder="Buscar colaborador…" aria-label="Buscar colaborador" oninput="renderViewColabList(this.value)">
                </div>
                <div class="colab-list" id="vcolab-list"></div>
              </div>
              <div class="colab-detail" id="vcolab-detail"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="view" id="view-v-trilhaExtra">
        <div class="window">
          <div class="window-head">
            <div>
              <p class="window-title">Trilha - Extra</p>
              <p class="window-sub">Visualização sequencial dos ciclos e módulos da trilha escolhida — respeitando a ordem de cadastro, sem rolagem lateral.</p>
            </div>
            <div class="tx-select-wrap">
              <label for="tx-trilha-select" class="tx-select-label">Trilha</label>
              <select id="tx-trilha-select" onchange="selectTrilhaExtra(this.value)"></select>
            </div>
          </div>
          <div class="window-body">
            <div class="legend">
              <span class="legend-item"><span class="legend-dot done"></span>Concluído</span>
              <span class="legend-item"><span class="legend-dot on"></span>Em andamento</span>
              <span class="legend-item"><span class="legend-dot off"></span>A iniciar</span>
            </div>
            <div id="vtrilhaextra-roadmap"></div>
          </div>
        </div>
      </div>

      <div class="view" id="view-v-frequencia">
        <div class="window">
          <div class="window-head">
            <div>
              <p class="window-title">Frequência</p>
              <p class="window-sub">Filtre pela data da aula (ou navegue por trilha/ciclo/tema/módulo) e faça a chamada da etapa.</p>
            </div>
          </div>
          <div class="window-body" style="padding-bottom:0;">
            <div class="freq-filters">
              <div class="tx-select-wrap">
                <label for="freq-data-input" class="tx-select-label">Data</label>
                <input type="date" id="freq-data-input" onchange="selectFreqData(this.value)">
              </div>
              <div class="tx-select-wrap">
                <label for="freq-trilha-select" class="tx-select-label">Trilha</label>
                <select id="freq-trilha-select" onchange="selectFreqTrilha(this.value)"></select>
              </div>
              <div class="tx-select-wrap">
                <label for="freq-ciclo-select" class="tx-select-label">Ciclo</label>
                <select id="freq-ciclo-select" onchange="selectFreqCiclo(this.value)"></select>
              </div>
              <div class="tx-select-wrap">
                <label for="freq-tema-select" class="tx-select-label">Tema</label>
                <select id="freq-tema-select" onchange="selectFreqTema(this.value)"></select>
              </div>
              <div class="tx-select-wrap">
                <label for="freq-modulo-select" class="tx-select-label">Módulo</label>
                <select id="freq-modulo-select" onchange="selectFreqModulo(this.value)"></select>
              </div>
              <div class="tx-select-wrap">
                <label for="freq-etapa-select" class="tx-select-label">Etapa</label>
                <select id="freq-etapa-select" onchange="selectFreqEtapa(this.value)"></select>
              </div>
            </div>
          </div>
          <div class="window-body">
            <div id="freq-content"></div>
          </div>
        </div>
      </div>

      <!-- ============ RELATÓRIOS ============ -->
      <div class="view" id="view-r-frequencia">
        <div class="window">
          <div class="window-head">
            <div>
              <p class="window-title">Relatório de frequência</p>
              <p class="window-sub">Todas as chamadas já fechadas — inclusive o histórico de versões quando uma chamada fechada é reaberta e editada.</p>
            </div>
            <div style="display:flex;gap:8px;align-items:flex-end;">
              <button type="button" class="btn-secondary" onclick="exportFrequencia()">Exportar Excel</button>
            </div>
          </div>
          <div class="window-body" style="padding-bottom:0;">
            <div class="freq-filters">
              <div class="tx-select-wrap">
                <label for="relfreq-data-input" class="tx-select-label">Data</label>
                <input type="date" id="relfreq-data-input" onchange="selectRelfreqData(this.value)">
              </div>
              <div class="tx-select-wrap">
                <label for="relfreq-trilha-select" class="tx-select-label">Trilha</label>
                <select id="relfreq-trilha-select" onchange="selectRelfreqTrilha(this.value)"></select>
              </div>
              <div class="tx-select-wrap">
                <label for="relfreq-ciclo-select" class="tx-select-label">Ciclo</label>
                <select id="relfreq-ciclo-select" onchange="selectRelfreqCiclo(this.value)"></select>
              </div>
              <div class="tx-select-wrap">
                <label for="relfreq-tema-select" class="tx-select-label">Tema</label>
                <select id="relfreq-tema-select" onchange="selectRelfreqTema(this.value)"></select>
              </div>
              <div class="tx-select-wrap">
                <label for="relfreq-modulo-select" class="tx-select-label">Módulo</label>
                <select id="relfreq-modulo-select" onchange="selectRelfreqModulo(this.value)"></select>
              </div>
              <div class="tx-select-wrap">
                <label for="relfreq-etapa-select" class="tx-select-label">Etapa</label>
                <select id="relfreq-etapa-select" onchange="selectRelfreqEtapa(this.value)"></select>
              </div>
            </div>
          </div>
