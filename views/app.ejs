function removeTemaImage(){
  temaImageDataUrl = null;
  updateTemaImagePreview();
}
function onTemaImageSelected(evt){
  const file = evt.target.files && evt.target.files[0];
  evt.target.value = '';
  if(!file) return;
  const reader = new FileReader();
  reader.onload = () => openCropModal(reader.result);
  reader.readAsDataURL(file);
}
function openCropModal(dataUrl){
  const img = document.getElementById('crop-img');
  cropState = { scale: 1, baseScale: 1, offsetX: 0, offsetY: 0, naturalW: 0, naturalH: 0, dragging: false, startX: 0, startY: 0, startOffsetX: 0, startOffsetY: 0 };
  img.onload = () => {
    cropState.naturalW = img.naturalWidth;
    cropState.naturalH = img.naturalHeight;
    cropState.baseScale = Math.max(CROP_STAGE_SIZE / img.naturalWidth, CROP_STAGE_SIZE / img.naturalHeight);
    document.getElementById('crop-zoom').value = 1;
    applyCropTransform();
  };
  img.src = dataUrl;
  document.getElementById('overlay-img-crop').classList.add('show');
  document.getElementById('modal-img-crop').classList.add('show');
}
function closeCropModal(){
  document.getElementById('overlay-img-crop').classList.remove('show');
  document.getElementById('modal-img-crop').classList.remove('show');
  cropState = null;
}
function applyCropTransform(){
  if(!cropState) return;
  const img = document.getElementById('crop-img');
  const scale = cropState.baseScale * cropState.scale;
  const w = cropState.naturalW * scale, h = cropState.naturalH * scale;
  const maxOffsetX = Math.max(0, (w - CROP_STAGE_SIZE) / 2);
  const maxOffsetY = Math.max(0, (h - CROP_STAGE_SIZE) / 2);
  cropState.offsetX = Math.min(maxOffsetX, Math.max(-maxOffsetX, cropState.offsetX));
  cropState.offsetY = Math.min(maxOffsetY, Math.max(-maxOffsetY, cropState.offsetY));
  const left = (CROP_STAGE_SIZE - w) / 2 + cropState.offsetX;
  const top = (CROP_STAGE_SIZE - h) / 2 + cropState.offsetY;
  img.style.width = w + 'px';
  img.style.height = h + 'px';
  img.style.left = left + 'px';
  img.style.top = top + 'px';
}
function onCropZoomChange(){
  if(!cropState) return;
  cropState.scale = parseFloat(document.getElementById('crop-zoom').value) || 1;
  applyCropTransform();
}
function cropStagePointerDown(evt){
  if(!cropState) return;
  cropState.dragging = true;
  cropState.startX = evt.clientX; cropState.startY = evt.clientY;
  cropState.startOffsetX = cropState.offsetX; cropState.startOffsetY = cropState.offsetY;
  evt.target.setPointerCapture && evt.target.setPointerCapture(evt.pointerId);
}
function cropStagePointerMove(evt){
  if(!cropState || !cropState.dragging) return;
  cropState.offsetX = cropState.startOffsetX + (evt.clientX - cropState.startX);
  cropState.offsetY = cropState.startOffsetY + (evt.clientY - cropState.startY);
  applyCropTransform();
}
function cropStagePointerUp(){
  if(cropState) cropState.dragging = false;
}
function confirmCrop(){
  if(!cropState) return;
  const img = document.getElementById('crop-img');
  const scale = cropState.baseScale * cropState.scale;
  const w = cropState.naturalW * scale, h = cropState.naturalH * scale;
  const left = (CROP_STAGE_SIZE - w) / 2 + cropState.offsetX;
  const top = (CROP_STAGE_SIZE - h) / 2 + cropState.offsetY;
  const factor = CROP_OUTPUT_SIZE / CROP_STAGE_SIZE;
  const canvas = document.createElement('canvas');
  canvas.width = CROP_OUTPUT_SIZE; canvas.height = CROP_OUTPUT_SIZE;
  const ctx = canvas.getContext('2d');
  ctx.imageSmoothingQuality = 'high';
  ctx.drawImage(img, 0, 0, cropState.naturalW, cropState.naturalH, left * factor, top * factor, w * factor, h * factor);
  temaImageDataUrl = canvas.toDataURL('image/jpeg', 0.92);
  updateTemaImagePreview();
  closeCropModal();
}
function askDeleteModule(){
  if(!editingModuleId) return;
  const m = moduloById(editingModuleId);
  openConfirm(`Excluir ${m?.nome||'módulo'}?`, 'O progresso dos colaboradores neste módulo também será removido.', async () => {
    await db.doc('modulos/'+editingModuleId).delete();
    await db.reload('progresso'); // exclusão em cascata acontece no banco
    await db.reload('modulo-etapas');
    await db.reload('modulo-frequencia');
    await db.reload('temas'); // carga horária do tema é a soma dos módulos
    closeModuleDrawer(); toast('Módulo excluído');
  });
}

/* ================= CICLOS (cadastro) ================= */
function renderCadastroCiclos(filter){
  const el = document.getElementById('ciclos-reg-list');
  if(dbUnavailable){ el.innerHTML = '<div class="empty-state">Este visualizador não tem acesso ao banco de dados do artifact.</div>'; return; }
  if(!isLoaded('ciclos') || !isLoaded('temas')){ el.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando ciclos…</div>'; return; }
  const f = norm(filter||'');
  const list = [...ciclos].filter(ci => norm(ci.nome).includes(f) || norm(trilhaById(ci.trilhaId)?.nome).includes(f))
    .sort((a,b)=> (trilhaById(a.trilhaId)?.nome||'').localeCompare(trilhaById(b.trilhaId)?.nome||'') || (a.ordem??0)-(b.ordem??0));
  if(!list.length){ el.innerHTML = ciclos.length===0 ? '<p class="colab-empty">Nenhum ciclo cadastrado ainda.</p>' : `<p class="colab-empty">Nenhum resultado para "${esc(filter||'')}".</p>`; return; }
  el.innerHTML = list.map(ci => {
    const nTemas = temasOf(ci.id).length;
    return `
    <div class="reg-row" onclick="openCycleModal('${ci.id}')">
      <div class="cycle-icon" style="width:26px;height:26px;flex-shrink:0;">${iconSvg(ci.icon)}</div>
      <div class="reg-row-main">
        <div class="reg-row-title">${esc(ci.nome)}${ci.transversal?' <span class="badge" style="vertical-align:middle;">Transversal</span>':''}</div>
        <div class="reg-row-sub">${esc(trilhaById(ci.trilhaId)?.nome || '—')}${ci.tema?' · '+esc(ci.tema):''} · ${nTemas} tema${nTemas===1?'':'s'}</div>
      </div>
      <span class="btn-ghost-sm" style="pointer-events:none;">${editSvg()}</span>
    </div>`;
  }).join('');
}

/* ================= MÓDULOS (cadastro) ================= */
function renderCadastroModulos(filter){
  const el = document.getElementById('modulos-reg-list');
  if(dbUnavailable){ el.innerHTML = '<div class="empty-state">Este visualizador não tem acesso ao banco de dados do artifact.</div>'; return; }
  if(!isLoaded('modulos') || !isLoaded('temas') || !isLoaded('ciclos')){ el.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando módulos…</div>'; return; }
  const f = norm(filter||'');
  const list = [...modulos].filter(m => norm(m.nome).includes(f) || norm(cicloOfModulo(m)?.nome).includes(f) || norm(temaById(m.temaId)?.titulo).includes(f))
    .sort((a,b)=> (a.ordem??0)-(b.ordem??0));
  if(!list.length){ el.innerHTML = modulos.length===0 ? '<p class="colab-empty">Nenhum módulo cadastrado ainda.</p>' : `<p class="colab-empty">Nenhum resultado para "${esc(filter||'')}".</p>`; return; }
  el.innerHTML = list.map(m => {
    const te = temaById(m.temaId); const ci = cicloOfModulo(m); const t = ci ? trilhaById(ci.trilhaId) : null;
    return `
    <div class="reg-row" onclick="openModuleForm('${m.id}')">
      <span class="cat-dot ${catDotClass(m.categoria)}" style="flex-shrink:0;"></span>
      <div class="reg-row-main">
        <div class="reg-row-title">${esc(m.nome)}</div>
        <div class="reg-row-sub">${esc(t?.nome||'—')} / ${esc(ci?.nome||'—')} / ${esc(te?.titulo||'—')} · ${esc(m.status||'A iniciar')}</div>
      </div>
      <span class="btn-ghost-sm" style="pointer-events:none;">${editSvg()}</span>
    </div>`;
  }).join('');
}

/* ================= UNIDADES ================= */
function renderUnidades(){
  const el = document.getElementById('unidades-list');
  if(dbUnavailable){ el.innerHTML = '<div class="empty-state">Este visualizador não tem acesso ao banco de dados do artifact.</div>'; return; }
  if(!isLoaded('unidades')){ el.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando…</div>'; return; }
  if(!unidades.length){ el.innerHTML = '<p style="font-size:12.5px;color:var(--ink-dim);">Nenhuma unidade cadastrada ainda. Use o campo abaixo para criar a primeira.</p>'; return; }
  el.innerHTML = unidades.map(u => {
    const count = colaboradores.filter(c=>c.unidadeId===u.id).length;
    if(unidadeEditingId===u.id){
      return `<div class="unidade-row">
        <input type="text" id="unidade-edit-input" value="${esc(u.nome)}" style="flex:1;font-family:var(--font);font-size:13.5px;padding:6px 9px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);">
        <button class="btn-ghost-sm" onclick="saveUnidadeEdit('${u.id}')" title="Salvar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg></button>
        <button class="btn-ghost-sm" onclick="unidadeEditingId=null; renderUnidades();" title="Cancelar">×</button>
      </div>`;
    }
    return `<div class="unidade-row">
      <span class="unidade-name">${esc(u.nome)}</span>
      <span class="unidade-count">${count} colaborador${count===1?'':'es'}</span>
      <button class="btn-ghost-sm" onclick="unidadeEditingId='${u.id}'; renderUnidades();" title="Renomear">${editSvg()}</button>
      <button class="btn-ghost-sm" onclick="deleteUnidade('${u.id}', ${count})" title="Excluir">${trashSvg()}</button>
    </div>`;
  }).join('');
}
async function addUnidade(){
  const input = document.getElementById('unidade-new-nome');
  const nome = input.value.trim();
  if(!nome){ toast('Informe o nome da unidade'); return; }
  if(!db){ toast('Banco indisponível'); return; }
  await db.collection('unidades').add({nome});
  input.value = ''; toast('Unidade adicionada');
}
async function saveUnidadeEdit(id){
  const nome = document.getElementById('unidade-edit-input').value.trim();
  if(!nome) return;
  await db.doc('unidades/'+id).update({nome});
  unidadeEditingId = null; toast('Unidade atualizada');
}
function deleteUnidade(id, count){
  if(count>0){ toast('Mova os colaboradores desta unidade antes de excluí-la'); return; }
  const u = unidadeById(id);
  openConfirm(`Excluir ${u?.nome||'unidade'}?`, 'Esta ação não pode ser desfeita.', async () => {
    await db.doc('unidades/'+id).delete(); toast('Unidade excluída');
  });
}

/* ================= Administrativo: Usuários ================= */
function renderUsuarios(){
  const el = document.getElementById('usuarios-list');
  if(dbUnavailable){ el.innerHTML = '<div class="empty-state">Este visualizador não tem acesso ao banco de dados do artifact.</div>'; return; }
  if(!isLoaded('usuarios')){ el.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando…</div>'; return; }
  if(!usuarios.length){ el.innerHTML = '<p style="font-size:12.5px;color:var(--ink-dim);">Nenhum usuário cadastrado ainda.</p>'; return; }
  el.innerHTML = usuarios.map(u => {
    const isSelf = u.id === currentUserId;
    const badge = u.isAdmin ? ' <span class="unidade-count">admin</span>' : '';
    if(usuarioEditingId===u.id){
      return `<div class="unidade-row" style="flex-wrap:wrap;">
        <input type="text" id="usuario-edit-nome" value="${esc(u.username)}" style="flex:1;min-width:140px;font-family:var(--font);font-size:13.5px;padding:6px 9px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);">
        <input type="password" id="usuario-edit-senha" placeholder="Nova senha (opcional)" style="flex:1;min-width:140px;font-family:var(--font);font-size:13.5px;padding:6px 9px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink);">
        <button class="btn-ghost-sm" onclick="saveUsuarioEdit('${u.id}')" title="Salvar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg></button>
        <button class="btn-ghost-sm" onclick="usuarioEditingId=null; renderUsuarios();" title="Cancelar">×</button>
        <label class="field-check" style="margin:0; width:100%;"><input type="checkbox" id="usuario-edit-admin" ${u.isAdmin?'checked':''}> Usuário administrador</label>
      </div>`;
    }
    return `<div class="unidade-row">
      <span class="unidade-name">${esc(u.username)}${isSelf ? ' <span class="unidade-count">(você)</span>' : ''}${badge}</span>
      <button class="btn-ghost-sm" onclick="usuarioEditingId='${u.id}'; renderUsuarios();" title="Editar">${editSvg()}</button>
      ${isSelf ? '' : `<button class="btn-ghost-sm" onclick="deleteUsuario('${u.id}', ${usuarios.length})" title="Excluir">${trashSvg()}</button>`}
    </div>`;
  }).join('');
}
async function addUsuario(){
  const nomeInput = document.getElementById('usuario-new-nome');
  const senhaInput = document.getElementById('usuario-new-senha');
  const adminInput = document.getElementById('usuario-new-admin');
  const username = nomeInput.value.trim();
  const password = senhaInput.value;
  if(!username || !password){ toast('Informe usuário e senha'); return; }
  if(!db){ toast('Banco indisponível'); return; }
  try{
    await db.collection('usuarios').add({username, password, isAdmin: adminInput.checked});
    nomeInput.value = ''; senhaInput.value = ''; adminInput.checked = false; toast('Usuário adicionado');
  }catch(e){ toast('Não foi possível criar o usuário (nome já existe?)'); }
}
async function saveUsuarioEdit(id){
  const username = document.getElementById('usuario-edit-nome').value.trim();
  const password = document.getElementById('usuario-edit-senha').value;
  const isAdmin = document.getElementById('usuario-edit-admin').checked;
  if(!username) return;
  const data = {username, isAdmin};
  if(password) data.password = password;
  try{
    await db.doc('usuarios/'+id).update(data);
    usuarioEditingId = null; toast('Usuário atualizado');
  }catch(e){ toast('Não foi possível atualizar (nome já existe, ou é o último administrador?)'); }
}
function deleteUsuario(id, total){
  if(total<=1){ toast('Não é possível excluir o último usuário'); return; }
  const u = usuarios.find(x=>x.id===id);
  openConfirm(`Excluir ${u?.username||'usuário'}?`, 'Esta ação não pode ser desfeita.', async () => {
    try{
      await db.doc('usuarios/'+id).delete(); toast('Usuário excluído');
    }catch(e){ toast('Não foi possível excluir (é o último administrador?)'); }
  });
}

/* ================= Confirm modal ================= */
function openConfirm(title, text, fn){
  document.getElementById('confirm-title').textContent = title;
  document.getElementById('confirm-text').textContent = text;
  confirmActionFn = fn;
  document.getElementById('overlay-confirm').classList.add('show');
  document.getElementById('modal-confirm').classList.add('show');
}
function closeConfirm(){ document.getElementById('overlay-confirm').classList.remove('show'); document.getElementById('modal-confirm').classList.remove('show'); confirmActionFn = null; }
async function confirmActionRun(){ const fn = confirmActionFn; closeConfirm(); if(fn) await fn(); }

/* ================= Autenticação por token ================= */
const TOKEN_KEY = 'jad_token';
function getToken(){ try{ return localStorage.getItem(TOKEN_KEY); }catch(e){ return null; } }
function setToken(t){ try{ localStorage.setItem(TOKEN_KEY, t); }catch(e){} }
function clearToken(){ try{ localStorage.removeItem(TOKEN_KEY); }catch(e){} }
function authHeaders(){ const t = getToken(); return t ? {'Authorization':'Bearer '+t} : {}; }

function showApp(){
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app-shell').style.display = 'flex';
}
function showLogin(){
  document.getElementById('app-shell').style.display = 'none';
  document.getElementById('login-screen').style.display = 'flex';
}

async function handleLogin(ev){
  ev.preventDefault();
  const errEl = document.getElementById('login-error');
  errEl.style.display = 'none';
  const user = document.getElementById('login-user').value;
  const pass = document.getElementById('login-pass').value;
  try{
    const res = await fetch('api/login', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({user, pass})
    });
    if(!res.ok){ errEl.style.display = 'block'; return false; }
    const data = await res.json();
    setToken(data.token);
    currentUserId = data.id;
    currentUserIsAdmin = !!data.isAdmin;
    applyAdminVisibility();
    showApp();
    boot();
  }catch(e){ errEl.style.display = 'block'; }
  return false;
}

async function doLogout(){
  const headers = authHeaders();
  clearToken();
  currentUserId = null;
  currentUserIsAdmin = false;
  showLogin();
  try{ await fetch('api/logout', { method:'POST', headers }); }catch(e){}
}

async function initAuth(){
  const token = getToken();
  if(!token){ showLogin(); return; }
  try{
    const res = await fetch('api/me', { headers: authHeaders() });
    if(!res.ok){ clearToken(); showLogin(); return; }
    const data = await res.json();
    currentUserId = data.id;
    currentUserIsAdmin = !!data.isAdmin;
    applyAdminVisibility();
    showApp();
    boot();
  }catch(e){ clearToken(); showLogin(); }
}

initAuth();
</script>
