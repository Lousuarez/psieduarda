/* ================= FREQUÊNCIA (facilitador) ================= */
function chamadaOf(etapaId){ return moduloChamadas.find(c=>c.etapaId===etapaId) || null; }
function etapaMatchesDate(e, date){
  if(!date) return true;
  const ini = e.dataInicio || e.dataFim;
  const fim = e.dataFim || e.dataInicio;
  if(!ini) return false;
  return date >= ini && date <= fim;
}
function formatDateHora(dt){
  if(!dt) return '';
  const d = new Date(dt);
  return d.toLocaleDateString('pt-BR') + ' às ' + d.toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
}
function selectFreqData(v){ freqData = v; freqModuloId = null; freqEtapaId = null; renderFrequenciaView(); }
function selectFreqTrilha(id){ freqTrilhaId = id; freqCicloId = ''; freqTemaId = ''; freqModuloId = null; freqEtapaId = null; renderFrequenciaView(); }
function selectFreqCiclo(id){ freqCicloId = id; freqTemaId = ''; freqModuloId = null; freqEtapaId = null; renderFrequenciaView(); }
function selectFreqTema(id){ freqTemaId = id; freqModuloId = null; freqEtapaId = null; renderFrequenciaView(); }
function selectFreqModulo(id){ freqModuloId = id; freqEtapaId = null; renderFrequenciaView(); }
function selectFreqEtapa(id){ freqEtapaId = id; renderFrequenciaView(); }

function renderFrequenciaView(){
  const dataInput = document.getElementById('freq-data-input');
  const trilhaSel = document.getElementById('freq-trilha-select');
  const cicloSel = document.getElementById('freq-ciclo-select');
  const temaSel = document.getElementById('freq-tema-select');
  const modSel = document.getElementById('freq-modulo-select');
  const etSel = document.getElementById('freq-etapa-select');
  const content = document.getElementById('freq-content');
  if(!dataInput || !trilhaSel || !cicloSel || !temaSel || !modSel || !etSel || !content) return;
  if(!currentUserIsAdmin){ content.innerHTML = '<div class="empty-state">Somente administradores podem realizar a chamada.</div>'; return; }
  if(dbUnavailable){ content.innerHTML = '<div class="empty-state">Este visualizador não tem acesso ao banco de dados do artifact.</div>'; return; }
  if(!isLoaded('modulos') || !isLoaded('temas') || !isLoaded('ciclos') || !isLoaded('trilhas') || !isLoaded('modulo-etapas') || !isLoaded('progresso') || !isLoaded('colaboradores') || !isLoaded('modulo-frequencia') || !isLoaded('modulo-etapa-chamada')){
    content.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando…</div>'; return;
  }

  dataInput.value = freqData || '';

  const eligibleMods = modulos.filter(m => m.temCronograma && moduloEtapas.some(e=>e.moduloId===m.id && etapaMatchesDate(e, freqData)));

  const trilhaIdsElig = [...new Set(eligibleMods.map(m => cicloOfModulo(m)?.trilhaId).filter(Boolean))];
  const trilhaOptions = trilhaIdsElig.map(id=>trilhaById(id)).filter(Boolean).sort((a,b)=>a.nome.localeCompare(b.nome));
  if(freqTrilhaId && !trilhaOptions.find(t=>t.id===freqTrilhaId)) freqTrilhaId = '';
  trilhaSel.innerHTML = '<option value="">(todas as trilhas)</option>' + trilhaOptions.map(t=>`<option value="${esc(t.id)}" ${t.id===freqTrilhaId?'selected':''}>${esc(t.nome)}</option>`).join('');

  const modsAfterTrilha = freqTrilhaId ? eligibleMods.filter(m => cicloOfModulo(m)?.trilhaId === freqTrilhaId) : eligibleMods;
  const cicloIdsElig = [...new Set(modsAfterTrilha.map(m=>cicloOfModulo(m)?.id).filter(Boolean))];
  const cicloOptions = cicloIdsElig.map(id=>cicloById(id)).filter(Boolean).sort((a,b)=>a.nome.localeCompare(b.nome));
  if(freqCicloId && !cicloOptions.find(c=>c.id===freqCicloId)) freqCicloId = '';
  cicloSel.innerHTML = '<option value="">(todos os ciclos)</option>' + cicloOptions.map(c=>`<option value="${esc(c.id)}" ${c.id===freqCicloId?'selected':''}>${esc(c.nome)}</option>`).join('');

  const modsAfterCiclo = freqCicloId ? modsAfterTrilha.filter(m=>cicloOfModulo(m)?.id===freqCicloId) : modsAfterTrilha;

  const temaIdsElig = [...new Set(modsAfterCiclo.map(m=>m.temaId).filter(Boolean))];
  const temaOptions = temaIdsElig.map(id=>temaById(id)).filter(Boolean).sort((a,b)=>a.titulo.localeCompare(b.titulo));
  if(freqTemaId && !temaOptions.find(t=>t.id===freqTemaId)) freqTemaId = '';
  temaSel.innerHTML = '<option value="">(todos os temas)</option>' + temaOptions.map(t=>`<option value="${esc(t.id)}" ${t.id===freqTemaId?'selected':''}>${esc(t.titulo)}</option>`).join('');

  const modsAfterTema = freqTemaId ? modsAfterCiclo.filter(m=>m.temaId===freqTemaId) : modsAfterCiclo;
  const moduloOptions = [...modsAfterTema].sort((a,b)=>{
    const ta = cicloOfModulo(a), tb = cicloOfModulo(b);
    return (trilhaById(ta?.trilhaId)?.nome||'').localeCompare(trilhaById(tb?.trilhaId)?.nome||'') || (a.ordem??0)-(b.ordem??0);
  });

  if(!moduloOptions.length){
    modSel.innerHTML = '<option value="">(nenhum módulo elegível)</option>';
    etSel.innerHTML = '';
    content.innerHTML = `<div class="empty-cta"><p class="empty-title">Nenhuma etapa encontrada</p><p>${freqData ? 'Nenhum módulo tem etapa cadastrada nessa data — troque a data ou limpe o filtro.' : 'Marque "Informar cronograma?" no cadastro de um módulo e adicione etapas para poder registrar frequência.'}</p></div>`;
    return;
  }
  if(!freqModuloId || !moduloOptions.find(m=>m.id===freqModuloId)) freqModuloId = moduloOptions[0].id;
  modSel.innerHTML = moduloOptions.map(m=>`<option value="${esc(m.id)}" ${m.id===freqModuloId?'selected':''}>${esc(m.nome)}</option>`).join('');

  const etapas = moduloEtapas.filter(e=>e.moduloId===freqModuloId && etapaMatchesDate(e, freqData)).sort((a,b)=>(a.ordem??0)-(b.ordem??0));
  if(!freqEtapaId || !etapas.find(e=>e.id===freqEtapaId)) freqEtapaId = etapas[0]?.id || null;
  etSel.innerHTML = etapas.map(e=>`<option value="${esc(e.id)}" ${e.id===freqEtapaId?'selected':''}>${esc(e.nome)}${e.dataInicio?' · '+formatDateBR(e.dataInicio):''}</option>`).join('');

  if(!freqEtapaId){
    content.innerHTML = `<div class="empty-cta"><p class="empty-title">Nenhuma etapa encontrada</p><p>${freqData ? 'Este módulo não tem etapa nessa data.' : 'Este módulo ainda não tem etapas cadastradas.'}</p></div>`;
    return;
  }

  const matriculados = progresso.filter(p=>p.moduloId===freqModuloId)
    .map(p=>({...p, colab: colaboradores.find(c=>c.id===p.colaboradorId)}))
    .filter(p=>p.colab)
    .sort((a,b)=>a.colab.nome.localeCompare(b.colab.nome));

  if(!matriculados.length){
    content.innerHTML = '<div class="empty-cta"><p class="empty-title">Ninguém matriculado neste módulo ainda</p><p>Matricule colaboradores pelo cadastro do módulo, na aba "Turma".</p></div>';
    return;
  }

  const chamada = chamadaOf(freqEtapaId);
  const presentCount = matriculados.filter(p => moduloFrequencia.find(f=>f.etapaId===freqEtapaId && f.colaboradorId===p.colab.id)?.presente).length;

  if(!chamada){
    content.innerHTML = `<div class="freq-lock">
      <p>A chamada desta etapa ainda não foi iniciada.</p>
      <button type="button" class="btn-save" onclick="iniciarChamada()">Iniciar chamada</button>
    </div>`;
    return;
  }

  if(chamada.status === 'fechada'){
    let html = `<div class="freq-chamada-status">
      <div>
        <p class="freq-summary-count" style="margin-bottom:2px;">${presentCount}<span>/${matriculados.length} presentes</span></p>
        <p class="freq-chamada-meta">Chamada fechada em ${formatDateHora(chamada.fechadaEm)}${chamada.fechadaPor?' por '+esc(chamada.fechadaPor):''}${chamada.versoesCount>1?' · '+chamada.versoesCount+' versões (ver Relatórios)':''}</p>
      </div>
      <button type="button" class="btn-secondary" onclick="reabrirChamada()">Reabrir para editar</button>
    </div>`;
    html += matriculados.map(p => {
      const presente = !!moduloFrequencia.find(f=>f.etapaId===freqEtapaId && f.colaboradorId===p.colab.id)?.presente;
      return `<div class="prog-row">
        <span class="prog-name">${esc(p.colab.nome)}</span>
        <span class="status-pill ${presente?'done':'off'}" style="pointer-events:none;">${presente?'Presente':'Ausente'}</span>
      </div>`;
    }).join('');
    content.innerHTML = html;
    return;
  }

  // aberta — editável
  let html = `<div class="freq-summary">
    <div>
      <p class="freq-summary-count">${presentCount}<span>/${matriculados.length} presentes</span></p>
      <p class="freq-chamada-meta">Chamada aberta desde ${formatDateHora(chamada.iniciadaEm)}${chamada.iniciadaPor?' por '+esc(chamada.iniciadaPor):''}</p>
    </div>
    <div class="freq-bulk-actions">
      <button type="button" class="btn-secondary" onclick="marcarTodosFrequencia(true)">Marcar todos presentes</button>
      <button type="button" class="btn-secondary" onclick="marcarTodosFrequencia(false)">Marcar todos ausentes</button>
      <button type="button" class="btn-save" onclick="fecharChamada()">Fechar chamada</button>
    </div>
  </div>`;
  html += matriculados.map(p => {
    const presente = !!moduloFrequencia.find(f=>f.etapaId===freqEtapaId && f.colaboradorId===p.colab.id)?.presente;
    return `<div class="prog-row">
      <span class="prog-name">${esc(p.colab.nome)}</span>
      <button class="status-pill ${presente?'done':'off'}" onclick="toggleFrequencia('${freqEtapaId}','${p.colab.id}',${presente})">${presente?'Presente':'Ausente'}</button>
    </div>`;
  }).join('');
  content.innerHTML = html;
}
async function iniciarChamada(){
  if(!db || !freqEtapaId) return;
  const res = await fetch('api/modulo-etapa-chamada/'+encodeURIComponent(freqEtapaId), {
    method:'PUT', headers:{...authHeaders(), 'Content-Type':'application/json'}, body: JSON.stringify({status:'aberta'})
  });
  if(!res.ok){ toast('Não foi possível iniciar a chamada'); return; }
  await db.reload('modulo-etapa-chamada');
  toast('Chamada iniciada');
}
async function fecharChamada(){
  if(!db || !freqEtapaId) return;
  const res = await fetch('api/modulo-etapa-chamada/'+encodeURIComponent(freqEtapaId), {
    method:'PUT', headers:{...authHeaders(), 'Content-Type':'application/json'}, body: JSON.stringify({status:'fechada'})
  });
  if(!res.ok){ toast('Não foi possível fechar a chamada'); return; }
  await db.reload('modulo-etapa-chamada');
  toast('Chamada fechada e salva');
}
async function reabrirChamada(){
  if(!db || !freqEtapaId) return;
  const res = await fetch('api/modulo-etapa-chamada/'+encodeURIComponent(freqEtapaId), {
    method:'PUT', headers:{...authHeaders(), 'Content-Type':'application/json'}, body: JSON.stringify({status:'aberta'})
  });
  if(!res.ok){ toast('Não foi possível reabrir a chamada'); return; }
  await db.reload('modulo-etapa-chamada');
  toast('Chamada reaberta — ao fechar de novo, uma nova versão é salva');
}
async function marcarTodosFrequencia(presente){
  if(!db || !freqEtapaId) return;
  const alvos = progresso.filter(p=>p.moduloId===freqModuloId).map(p=>p.colaboradorId);
  for(const colabId of alvos){
    await fetch('api/modulo-frequencia/'+encodeURIComponent(freqEtapaId)+'/'+encodeURIComponent(colabId), {
      method:'PUT', headers:{...authHeaders(), 'Content-Type':'application/json'}, body: JSON.stringify({presente})
    });
  }
  await db.reload('modulo-frequencia');
  toast(presente ? 'Todos marcados como presentes' : 'Todos marcados como ausentes');
}

/* ================= RELATÓRIOS: Frequência ================= */
function selectRelfreqData(v){ relfreqData = v; relfreqModuloId = ''; relfreqEtapaId = ''; renderRelatorioFrequencia(document.getElementById('relfreq-search')?.value); }
function selectRelfreqTrilha(id){ relfreqTrilhaId = id; relfreqCicloId = ''; relfreqTemaId = ''; relfreqModuloId = ''; relfreqEtapaId = ''; renderRelatorioFrequencia(document.getElementById('relfreq-search')?.value); }
function selectRelfreqCiclo(id){ relfreqCicloId = id; relfreqTemaId = ''; relfreqModuloId = ''; relfreqEtapaId = ''; renderRelatorioFrequencia(document.getElementById('relfreq-search')?.value); }
function selectRelfreqTema(id){ relfreqTemaId = id; relfreqModuloId = ''; relfreqEtapaId = ''; renderRelatorioFrequencia(document.getElementById('relfreq-search')?.value); }
function selectRelfreqModulo(id){ relfreqModuloId = id; relfreqEtapaId = ''; renderRelatorioFrequencia(document.getElementById('relfreq-search')?.value); }
function selectRelfreqEtapa(id){ relfreqEtapaId = id; renderRelatorioFrequencia(document.getElementById('relfreq-search')?.value); }

function renderRelatorioFrequencia(filter){
  const el = document.getElementById('relfreq-list');
  const dataInput = document.getElementById('relfreq-data-input');
  const trilhaSel = document.getElementById('relfreq-trilha-select');
  const cicloSel = document.getElementById('relfreq-ciclo-select');
  const temaSel = document.getElementById('relfreq-tema-select');
  const modSel = document.getElementById('relfreq-modulo-select');
  const etSel = document.getElementById('relfreq-etapa-select');
  if(!el || !dataInput || !trilhaSel || !cicloSel || !temaSel || !modSel || !etSel) return;
  if(dbUnavailable){ el.innerHTML = '<div class="empty-state">Este visualizador não tem acesso ao banco de dados do artifact.</div>'; return; }
  if(!isLoaded('modulo-etapa-chamada') || !isLoaded('modulo-etapas') || !isLoaded('modulos') || !isLoaded('temas') || !isLoaded('ciclos') || !isLoaded('trilhas')){
    el.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando…</div>'; return;
  }

  dataInput.value = relfreqData || '';

  const base = moduloChamadas.filter(c => c.versoesCount > 0).map(c => {
    const e = moduloEtapas.find(x=>x.id===c.etapaId);
    const m = e ? moduloById(e.moduloId) : null;
    const te = m ? temaById(m.temaId) : null;
    const ci = te ? cicloById(te.cicloId) : null;
    const t = ci ? trilhaById(ci.trilhaId) : null;
    return { chamada: c, etapa: e, modulo: m, tema: te, ciclo: ci, trilha: t };
  }).filter(r => r.etapa && r.modulo && r.tema && r.ciclo && r.trilha);

  const afterData = base.filter(r => etapaMatchesDate(r.etapa, relfreqData));

  const trilhaOptions = [...new Map(afterData.map(r=>[r.trilha.id, r.trilha])).values()].sort((a,b)=>a.nome.localeCompare(b.nome));
  if(relfreqTrilhaId && !trilhaOptions.find(t=>t.id===relfreqTrilhaId)) relfreqTrilhaId = '';
  trilhaSel.innerHTML = '<option value="">(todas as trilhas)</option>' + trilhaOptions.map(t=>`<option value="${esc(t.id)}" ${t.id===relfreqTrilhaId?'selected':''}>${esc(t.nome)}</option>`).join('');

  const afterTrilha = relfreqTrilhaId ? afterData.filter(r=>r.trilha.id===relfreqTrilhaId) : afterData;
  const cicloOptions = [...new Map(afterTrilha.map(r=>[r.ciclo.id, r.ciclo])).values()].sort((a,b)=>a.nome.localeCompare(b.nome));
  if(relfreqCicloId && !cicloOptions.find(c=>c.id===relfreqCicloId)) relfreqCicloId = '';
  cicloSel.innerHTML = '<option value="">(todos os ciclos)</option>' + cicloOptions.map(c=>`<option value="${esc(c.id)}" ${c.id===relfreqCicloId?'selected':''}>${esc(c.nome)}</option>`).join('');

  const afterCiclo = relfreqCicloId ? afterTrilha.filter(r=>r.ciclo.id===relfreqCicloId) : afterTrilha;
  const temaOptions = [...new Map(afterCiclo.map(r=>[r.tema.id, r.tema])).values()].sort((a,b)=>a.titulo.localeCompare(b.titulo));
  if(relfreqTemaId && !temaOptions.find(t=>t.id===relfreqTemaId)) relfreqTemaId = '';
  temaSel.innerHTML = '<option value="">(todos os temas)</option>' + temaOptions.map(t=>`<option value="${esc(t.id)}" ${t.id===relfreqTemaId?'selected':''}>${esc(t.titulo)}</option>`).join('');

  const afterTema = relfreqTemaId ? afterCiclo.filter(r=>r.tema.id===relfreqTemaId) : afterCiclo;
  const moduloOptions = [...new Map(afterTema.map(r=>[r.modulo.id, r.modulo])).values()].sort((a,b)=>a.nome.localeCompare(b.nome));
  if(relfreqModuloId && !moduloOptions.find(m=>m.id===relfreqModuloId)) relfreqModuloId = '';
  modSel.innerHTML = '<option value="">(todos os módulos)</option>' + moduloOptions.map(m=>`<option value="${esc(m.id)}" ${m.id===relfreqModuloId?'selected':''}>${esc(m.nome)}</option>`).join('');

  const afterModulo = relfreqModuloId ? afterTema.filter(r=>r.modulo.id===relfreqModuloId) : afterTema;
  const etapaOptions = [...new Map(afterModulo.map(r=>[r.etapa.id, r.etapa])).values()].sort((a,b)=>(a.ordem??0)-(b.ordem??0));
  if(relfreqEtapaId && !etapaOptions.find(e=>e.id===relfreqEtapaId)) relfreqEtapaId = '';
  etSel.innerHTML = '<option value="">(todas as etapas)</option>' + etapaOptions.map(e=>`<option value="${esc(e.id)}" ${e.id===relfreqEtapaId?'selected':''}>${esc(e.nome)}${e.dataInicio?' · '+formatDateBR(e.dataInicio):''}</option>`).join('');

  let registros = relfreqEtapaId ? afterModulo.filter(r=>r.etapa.id===relfreqEtapaId) : afterModulo;

  const f = norm(filter||'');
  if(f){
    registros = registros.filter(r => norm(r.trilha.nome).includes(f) || norm(r.ciclo.nome).includes(f) || norm(r.tema.titulo).includes(f) || norm(r.modulo.nome).includes(f) || norm(r.etapa.nome).includes(f));
  }
  registros.sort((a,b) => new Date(b.chamada.fechadaEm||0) - new Date(a.chamada.fechadaEm||0));

  if(!registros.length){
    el.innerHTML = base.length ? '<p class="colab-empty">Nenhum resultado para os filtros aplicados.</p>' : '<p class="colab-empty">Nenhuma chamada fechada ainda.</p>';
    return;
  }

  el.innerHTML = registros.map(r => {
    const isOpen = relfreqOpen.has(r.etapa.id);
    return `<div class="relfreq-row">
      <div class="relfreq-row-head" onclick="toggleRelfreqRow('${r.etapa.id}')">
        <div class="relfreq-row-main">
          <div class="reg-row-title">${esc(r.trilha?.nome||'—')} / ${esc(r.tema?.titulo||'—')} / ${esc(r.modulo?.nome||'—')} — ${esc(r.etapa.nome)}</div>
          <div class="reg-row-sub">${r.etapa.dataInicio?formatDateBR(r.etapa.dataInicio)+' · ':''}${r.chamada.status==='fechada'?'Fechada':'Reaberta (em edição)'} em ${formatDateHora(r.chamada.fechadaEm)}${r.chamada.fechadaPor?' por '+esc(r.chamada.fechadaPor):''}${r.chamada.versoesCount>1?' · '+r.chamada.versoesCount+' versões':''}</div>
        </div>
        <span class="btn-ghost-sm" style="pointer-events:none;">${isOpen?'▲':'▼'}</span>
      </div>
      ${isOpen ? `<div class="relfreq-row-body" id="relfreq-body-${r.etapa.id}"><div class="loading-row"><span class="spinner"></span>Carregando versões…</div></div>` : ''}
    </div>`;
  }).join('');

  registros.forEach(r => { if(relfreqOpen.has(r.etapa.id)) loadRelfreqVersoes(r.etapa.id); });
}
function toggleRelfreqRow(etapaId){
  if(relfreqOpen.has(etapaId)) relfreqOpen.delete(etapaId); else relfreqOpen.add(etapaId);
  renderRelatorioFrequencia(document.getElementById('relfreq-search')?.value);
}
async function loadRelfreqVersoes(etapaId){
  if(!relfreqVersoesCache[etapaId]){
    try{
      const res = await fetch('api/modulo-etapa-chamada/'+encodeURIComponent(etapaId)+'/versoes', { headers: authHeaders() });
      const data = await res.json();
      relfreqVersoesCache[etapaId] = data.docs;
    }catch(e){ relfreqVersoesCache[etapaId] = []; }
  }
  const body = document.getElementById('relfreq-body-'+etapaId);
  if(!body) return;
  const versoes = relfreqVersoesCache[etapaId];
  if(!versoes.length){ body.innerHTML = '<p class="field-hint" style="margin:0;">Nenhuma versão encontrada.</p>'; return; }
  body.innerHTML = versoes.map(v => {
    const presentes = v.presencas.filter(p=>p.presente).length;
    const motivoLabel = v.motivo === 'fechamento' ? 'Fechamento original' : 'Edição';
    const rows = [...v.presencas].sort((a,b)=>{
      const na = colaboradores.find(c=>c.id===a.colaboradorId)?.nome || '';
      const nb = colaboradores.find(c=>c.id===b.colaboradorId)?.nome || '';
      return na.localeCompare(nb);
    }).map(p => {
      const nome = colaboradores.find(c=>c.id===p.colaboradorId)?.nome || '(colaborador removido)';
      return `<div class="prog-row prog-row-sm"><span class="prog-name">${esc(nome)}</span><span class="status-pill ${p.presente?'done':'off'}" style="pointer-events:none;">${p.presente?'Presente':'Ausente'}</span></div>`;
    }).join('');
    return `<div class="relfreq-versao">
      <p class="relfreq-versao-title">Versão ${v.versao} · ${motivoLabel} · ${formatDateHora(v.criadaEm)}${v.criadaPor?' por '+esc(v.criadaPor):''} · ${presentes}/${v.presencas.length} presentes</p>
      ${rows}
    </div>`;
  }).join('');
}
async function exportFrequencia(){
  toast('Gerando planilha…');
  try{
    const res = await fetch('api/export/frequencia', { headers: authHeaders() });
    if(!res.ok){ toast('Não foi possível exportar'); return; }
    const blob = await res.blob();
    const disposition = res.headers.get('Content-Disposition') || '';
    const match = disposition.match(/filename="([^"]+)"/);
    const filename = match ? match[1] : 'frequencia.xlsx';
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); a.remove();
    URL.revokeObjectURL(url);
    toast('Planilha baixada');
  }catch(e){ toast('Não foi possível exportar'); }
}

/* ================= RELATÓRIOS: Frequência por colaborador ================= */
async function renderRelfreqColabView(filter){
  renderRelfreqColabList(filter);
  await loadRelfreqColabPresencas();
  renderRelfreqColabDetail();
}
async function loadRelfreqColabPresencas(){
  try{
    const res = await fetch('api/modulo-etapa-chamada/presencas', { headers: authHeaders() });
    const data = await res.json();
    relfreqColabPresencas = data.docs;
  }catch(e){ relfreqColabPresencas = []; }
}
function renderRelfreqColabList(filter){
  const list = document.getElementById('relfreqcolab-list');
  if(!list) return;
  const f = norm(filter||'');
  const items = [...colaboradores].filter(c => norm(c.nome).includes(f)).sort((a,b)=>(a.nome||'').localeCompare(b.nome||''));
  if(dbUnavailable){ list.innerHTML = '<p class="colab-empty">Banco de dados indisponível nesta visualização.</p>'; return; }
  if(!isLoaded('colaboradores')){ list.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando…</div>'; return; }
  if(colaboradores.length===0){ list.innerHTML = '<p class="colab-empty">Nenhum colaborador cadastrado ainda.</p>'; return; }
  if(items.length===0){ list.innerHTML = `<p class="colab-empty">Nenhum resultado para "${esc(filter||'')}".</p>`; return; }
  list.innerHTML = items.map(c => `
    <button class="colab-btn ${c.id===relfreqColabSelected?'selected':''} ${c.ativo===false?'inativo':''}" onclick="selectRelfreqColab('${c.id}')">
      ${c.lideranca ? '<span class="lead-dot" title="Liderança"></span>' : '<span style="width:6px"></span>'}
      <span class="colab-btn-name">${esc(c.nome)}</span>
    </button>`).join('');
}
function selectRelfreqColab(id){
  relfreqColabSelected = id;
  renderRelfreqColabList(document.getElementById('relfreqcolab-search')?.value);
  renderRelfreqColabDetail();
}
function renderRelfreqColabDetail(){
  const el = document.getElementById('relfreqcolab-detail');
  if(!el) return;
  if(dbUnavailable){ el.innerHTML = '<div class="empty-state">Este visualizador não tem acesso ao banco de dados do artifact.</div>'; return; }
  if(!isLoaded('modulo-etapas') || !isLoaded('modulos') || !isLoaded('temas') || !isLoaded('ciclos') || !isLoaded('trilhas') || relfreqColabPresencas===null){
    el.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando…</div>'; return;
  }
  const c = colaboradores.find(x=>x.id===relfreqColabSelected);
  if(!c){ el.innerHTML = '<div class="empty-state">Selecione um colaborador na lista.</div>'; return; }

  const registros = relfreqColabPresencas.filter(p=>p.colaboradorId===c.id).map(p=>{
    const e = moduloEtapas.find(x=>x.id===p.etapaId);
    const m = e ? moduloById(e.moduloId) : null;
    const te = m ? temaById(m.temaId) : null;
    const ci = te ? cicloById(te.cicloId) : null;
    const t = ci ? trilhaById(ci.trilhaId) : null;
    return { etapa: e, modulo: m, tema: te, ciclo: ci, trilha: t, presente: p.presente };
  }).filter(r => r.etapa && r.modulo && r.tema && r.ciclo && r.trilha);

  const total = registros.length;
  const presentes = registros.filter(r=>r.presente).length;
  const pct = total ? Math.round(presentes/total*100) : 0;

  let html = `<div class="colab-head-row">
    <div>
      <h2>${esc(c.nome)}</h2>
      <div class="colab-meta-row">
        ${c.lideranca ? '<span class="badge lideranca">Liderança</span>' : ''}
        ${c.ativo===false ? '<span class="badge inativo">Inativo</span>' : ''}
      </div>
    </div>
    ${total ? `<div class="colab-head-stat">
      <span class="colab-head-stat-num">${pct}%</span>
      <span class="colab-head-stat-label">${presentes}/${total} aulas presentes</span>
    </div>` : ''}
  </div>`;

  if(!total){
    html += `<p style="font-size:12.5px;color:var(--ink-dim);">Nenhuma chamada fechada envolvendo este colaborador ainda.</p>`;
    el.innerHTML = html;
    return;
  }

  html += `<div class="section-h">Por trilha</div>`;
  const trilhasMap = new Map();
  registros.forEach(r => { if(!trilhasMap.has(r.trilha.id)) trilhasMap.set(r.trilha.id, { trilha:r.trilha, regs:[] }); trilhasMap.get(r.trilha.id).regs.push(r); });
  [...trilhasMap.values()].sort((a,b)=>a.trilha.nome.localeCompare(b.trilha.nome)).forEach(({trilha, regs}) => {
    const pT = regs.filter(r=>r.presente).length;
    const pctT = regs.length ? Math.round(pT/regs.length*100) : 0;
    html += `<div class="progress-group">
      <div class="progress-group-title">${esc(trilha.nome)}</div>
      <div class="progress-group-stat-row">
        <span class="progress-group-stat-num">${pctT}%</span>
        <span class="progress-group-stat-label">${pT}/${regs.length} aulas presentes</span>
      </div>
      <div class="progress-bar-outer"><div class="progress-bar-inner" style="width:${pctT}%"></div></div>`;

    const ciclosMap = new Map();
    regs.forEach(r => { if(!ciclosMap.has(r.ciclo.id)) ciclosMap.set(r.ciclo.id, { ciclo:r.ciclo, regs:[] }); ciclosMap.get(r.ciclo.id).regs.push(r); });
    [...ciclosMap.values()].sort((a,b)=>a.ciclo.nome.localeCompare(b.ciclo.nome)).forEach(({ciclo, regs: regsCi}) => {
      const pCi = regsCi.filter(r=>r.presente).length;
      const pctCi = regsCi.length ? Math.round(pCi/regsCi.length*100) : 0;
      html += `<div class="progress-cycle-card">
        <div class="progress-cycle-head">
          <span class="progress-cycle-title">${esc(ciclo.nome)}</span>
          <span class="progress-cycle-count">${pCi}/${regsCi.length}</span>
        </div>
        <div class="progress-bar-outer progress-bar-outer-sm"><div class="progress-bar-inner" style="width:${pctCi}%"></div></div>`;

      const temasMap = new Map();
      regsCi.forEach(r => { if(!temasMap.has(r.tema.id)) temasMap.set(r.tema.id, { tema:r.tema, regs:[] }); temasMap.get(r.tema.id).regs.push(r); });
      [...temasMap.values()].sort((a,b)=>(a.tema.ordem??0)-(b.tema.ordem??0) || a.tema.titulo.localeCompare(b.tema.titulo)).forEach(({tema, regs: regsTe}) => {
        const pTe = regsTe.filter(r=>r.presente).length;
        const pctTe = regsTe.length ? Math.round(pTe/regsTe.length*100) : 0;
        html += `<div class="progress-tema-group">
          <div class="progress-tema-head">
            <span class="progress-tema-title">${esc(tema.titulo)}${tema.mes?' · '+esc(tema.mes):''}</span>
            <span class="progress-tema-count">${pTe}/${regsTe.length}</span>
          </div>
          <div class="progress-bar-outer progress-bar-outer-sm"><div class="progress-bar-inner" style="width:${pctTe}%"></div></div>
          <div class="prog-list">`;

        const modsMap = new Map();
        regsTe.forEach(r => { if(!modsMap.has(r.modulo.id)) modsMap.set(r.modulo.id, { modulo:r.modulo, regs:[] }); modsMap.get(r.modulo.id).regs.push(r); });
        [...modsMap.values()].sort((a,b)=>a.modulo.nome.localeCompare(b.modulo.nome)).forEach(({modulo, regs: regsMod}) => {
          const pMod = regsMod.filter(r=>r.presente).length;
          html += `<div class="prog-row"><span class="prog-name">${esc(modulo.nome)}</span><span class="status-pill ${pMod===regsMod.length?'done':(pMod===0?'off':'on')}" style="pointer-events:none;">${pMod}/${regsMod.length}</span></div>`;
          [...regsMod].sort((a,b)=>(a.etapa.ordem??0)-(b.etapa.ordem??0)).forEach(r => {
            html += `<div class="prog-row prog-row-sm"><span class="prog-name">${esc(r.etapa.nome)}${r.etapa.dataInicio?' · '+formatDateBR(r.etapa.dataInicio):''}</span><span class="status-pill ${r.presente?'done':'off'}" style="pointer-events:none;">${r.presente?'Presente':'Ausente'}</span></div>`;
          });
        });
        html += `</div></div>`;
      });
      html += `</div>`;
    });
    html += `</div>`;
  });

  el.innerHTML = html;
}

/* ================= RELATÓRIOS: Auditoria ================= */
let auditFiltrosLoaded = false;
let auditDocs = [];
let auditTotal = 0;
let auditOffset = 0;
const AUDIT_LIMIT = 100;
const auditOpen = new Set();
let auditSearchTimer = null;

async function renderAuditoriaView(){
  if(!currentUserIsAdmin) return;
  if(!auditFiltrosLoaded){
    await loadAuditFiltros();
    auditFiltrosLoaded = true;
  }
  await fetchAudit(true);
}
async function loadAuditFiltros(){
  try{
    const res = await fetch('api/auditoria/filtros', { headers: authHeaders() });
    const data = await res.json();
    const entSel = document.getElementById('audit-entidade-select');
    if(entSel) entSel.innerHTML = '<option value="">(todas as áreas)</option>' + data.entidades.map(e=>`<option value="${esc(e.valor)}">${esc(e.label)}</option>`).join('');
    const userSel = document.getElementById('audit-usuario-select');
    if(userSel) userSel.innerHTML = '<option value="">(todos os usuários)</option>' + data.usuarios.map(u=>`<option value="${esc(u)}">${esc(u)}</option>`).join('');
  }catch(e){}
}
function onAuditFilterChange(){ fetchAudit(true); }
function onAuditSearchInput(){
  clearTimeout(auditSearchTimer);
  auditSearchTimer = setTimeout(()=>fetchAudit(true), 300);
}
function auditQueryParams(offset){
  const params = new URLSearchParams();
  const entidade = document.getElementById('audit-entidade-select')?.value;
  const acao = document.getElementById('audit-acao-select')?.value;
  const usuarioNome = document.getElementById('audit-usuario-select')?.value;
  const de = document.getElementById('audit-de-input')?.value;
  const ate = document.getElementById('audit-ate-input')?.value;
  const q = document.getElementById('audit-search')?.value;
  if(entidade) params.set('entidade', entidade);
  if(acao) params.set('acao', acao);
  if(usuarioNome) params.set('usuarioNome', usuarioNome);
  if(de) params.set('de', de);
  if(ate) params.set('ate', ate);
  if(q) params.set('q', q);
  params.set('limit', AUDIT_LIMIT);
  params.set('offset', offset);
  return params;
}
async function fetchAudit(reset){
  const list = document.getElementById('audit-list');
  if(!list) return;
  if(reset){ auditOffset = 0; auditDocs = []; auditOpen.clear(); list.innerHTML = '<div class="loading-row"><span class="spinner"></span>Carregando…</div>'; }
  try{
    const params = auditQueryParams(auditOffset);
    const res = await fetch('api/auditoria?'+params.toString(), { headers: authHeaders() });
    if(!res.ok){ list.innerHTML = '<p class="colab-empty">Não foi possível carregar a auditoria.</p>'; return; }
    const data = await res.json();
    auditDocs = reset ? data.docs : [...auditDocs, ...data.docs];
    auditTotal = data.total;
    renderAuditList();
  }catch(e){ list.innerHTML = '<p class="colab-empty">Não foi possível carregar a auditoria.</p>'; }
}
function loadMoreAudit(){
  auditOffset += AUDIT_LIMIT;
  fetchAudit(false);
}
function renderAuditList(){
  const list = document.getElementById('audit-list');
  const countEl = document.getElementById('audit-count');
  const moreBtn = document.getElementById('audit-load-more');
  if(!list) return;
  if(countEl) countEl.textContent = auditTotal ? `${auditDocs.length} de ${auditTotal} registro${auditTotal===1?'':'s'}` : '';
  if(!auditDocs.length){ list.innerHTML = '<p class="colab-empty">Nenhum registro de auditoria para os filtros aplicados.</p>'; if(moreBtn) moreBtn.style.display='none'; return; }
  list.innerHTML = auditDocs.map(a => {
    const isOpen = auditOpen.has(a.id);
    return `<div class="relfreq-row">
      <div class="relfreq-row-head" onclick="toggleAuditRow('${a.id}')">
        <div class="relfreq-row-main">
          <div class="reg-row-title">${esc(a.interface||a.entidade)}<span class="audit-badge audit-badge-${a.acao}">${auditAcaoLabel(a.acao)}</span></div>
          <div class="reg-row-sub">${formatDateHora(a.criadoEm)} · ${esc(a.usuarioNome||'—')} · ID ${esc(a.entidadeId)}</div>
        </div>
        <span class="btn-ghost-sm" style="pointer-events:none;">${isOpen?'▲':'▼'}</span>
      </div>
      ${isOpen ? `<div class="relfreq-row-body">${auditDiffHtml(a)}</div>` : ''}
    </div>`;
  }).join('');
  if(moreBtn) moreBtn.style.display = auditDocs.length < auditTotal ? '' : 'none';
}
function toggleAuditRow(id){
  if(auditOpen.has(id)) auditOpen.delete(id); else auditOpen.add(id);
  renderAuditList();
}
function auditAcaoLabel(acao){ return acao==='create'?'Criação':acao==='delete'?'Exclusão':'Atualização'; }
function humanizeKey(k){ return k.replace(/([A-Z])/g,' $1').replace(/^./,c=>c.toUpperCase()); }
function formatAuditValue(v){
  if(v===null || v===undefined || v==='') return '—';
  if(typeof v==='boolean') return v?'Sim':'Não';
  if(Array.isArray(v)) return v.length ? v.join(', ') : '—';
  if(typeof v==='object') return JSON.stringify(v);
  return String(v);
}
function auditDiffHtml(a){
  const antes = a.valoresAntes || {};
  const depois = a.valoresDepois || {};
  if(a.acao==='create'){
    const keys = Object.keys(depois).filter(k=>k!=='id');
    if(!keys.length) return '<p class="field-hint" style="margin:0;">Sem detalhes registrados.</p>';
    return keys.map(k=>`<div class="prog-row prog-row-sm"><span class="prog-name">${esc(humanizeKey(k))}</span><span style="font-size:12px;color:var(--ink-dim);">${esc(formatAuditValue(depois[k]))}</span></div>`).join('');
  }
  if(a.acao==='delete'){
    const keys = Object.keys(antes).filter(k=>k!=='id');
    if(!keys.length) return '<p class="field-hint" style="margin:0;">Sem detalhes registrados.</p>';
    return keys.map(k=>`<div class="prog-row prog-row-sm"><span class="prog-name">${esc(humanizeKey(k))}</span><span style="font-size:12px;color:var(--ink-dim);">${esc(formatAuditValue(antes[k]))}</span></div>`).join('');
  }
  const keys = [...new Set([...Object.keys(antes), ...Object.keys(depois)])].filter(k=>k!=='id');
  const changed = keys.filter(k => JSON.stringify(antes[k]) !== JSON.stringify(depois[k]));
  if(!changed.length) return '<p class="field-hint" style="margin:0;">Nenhum campo mudou de valor.</p>';
  return changed.map(k => `<div class="audit-diff-row">
    <span class="prog-name">${esc(humanizeKey(k))}</span>
    <span class="audit-diff-before">${esc(formatAuditValue(antes[k]))}</span>
    <span class="audit-diff-arrow">→</span>
    <span class="audit-diff-after">${esc(formatAuditValue(depois[k]))}</span>
  </div>`).join('');
}

