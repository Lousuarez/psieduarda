function renderModuleTurma(){
  const el = document.getElementById('module-turma-content');
  if(!el) return;
  if(!editingModuleId){
    el.innerHTML = '<p class="field-hint" style="margin:0;">Salve o módulo para poder matricular colaboradores.</p>';
    return;
  }
  const m = moduloById(editingModuleId);
  const ci = m ? cicloOfModulo(m) : null;
  const trilha = ci ? trilhaById(ci.trilhaId) : null;
  const matriculados = progresso.filter(p=>p.moduloId===editingModuleId)
    .map(p=>({...p, colab: colaboradores.find(c=>c.id===p.colaboradorId)}))
    .filter(p=>p.colab)
    .sort((a,b)=>a.colab.nome.localeCompare(b.colab.nome));

  let html = `<div class="section-h">Colaboradores matriculados (${matriculados.length})</div>`;
  if(matriculados.length){
    html += matriculados.map(p => `
      <div class="prog-row">
        <span class="prog-name">${esc(p.colab.nome)}</span>
        <div style="display:flex;align-items:center;gap:8px;">
          <button class="status-pill ${statusPillClass(p.status)}" onclick="cycleProgresso('${p.colab.id}','${editingModuleId}')">${esc(p.status)}</button>
          <button class="prog-remove-btn" onclick="desmatricularDoModulo('${p.colab.id}')" title="Remover da turma">×</button>
        </div>
      </div>`).join('');
  } else {
    html += '<p class="field-hint" style="margin:0 0 10px;">Ninguém matriculado ainda.</p>';
  }

  const available = colaboradores.filter(c => !matriculados.find(p=>p.colab.id===c.id)).sort((a,b)=>a.nome.localeCompare(b.nome));
  if(available.length){
    html += `<select class="add-chip-select" style="margin-top:12px;" onchange="if(this.value){matricularNoModulo(this.value); this.value='';}">
      <option value="">+ matricular colaborador</option>${available.map(c=>`<option value="${esc(c.id)}">${esc(c.nome)}</option>`).join('')}</select>`;
    if(trilha) html += `<p class="field-hint">Quem ainda não estiver na trilha "${esc(trilha.nome)}" será adicionado a ela automaticamente.</p>`;
  }
  el.innerHTML = html;
}
async function matricularNoModulo(colabId){
  if(!db || !editingModuleId) return;
  const m = moduloById(editingModuleId);
  const ci = m ? cicloOfModulo(m) : null;
  const c = colaboradores.find(x=>x.id===colabId);
  if(ci && c && !(c.trilhaIds||[]).includes(ci.trilhaId)){
    await fetch('api/colaboradores/'+encodeURIComponent(colabId)+'/trilhas/'+encodeURIComponent(ci.trilhaId), { method:'POST', headers: authHeaders() });
    await db.reload('colaboradores');
  }
  await fetch('api/progresso/'+encodeURIComponent(colabId)+'/'+encodeURIComponent(editingModuleId), {
    method:'PUT', headers:{...authHeaders(), 'Content-Type':'application/json'}, body: JSON.stringify({status:'Em andamento'})
  });
  await db.reload('progresso');
  toast('Colaborador matriculado');
}
async function desmatricularDoModulo(colabId){
  if(!db || !editingModuleId) return;
  await fetch('api/progresso/'+encodeURIComponent(colabId)+'/'+encodeURIComponent(editingModuleId), {
    method:'PUT', headers:{...authHeaders(), 'Content-Type':'application/json'}, body: JSON.stringify({status:'Não iniciado'})
  });
  await db.reload('progresso');
  toast('Colaborador removido da turma');
}
function renderModuleCronograma(){
  const el = document.getElementById('module-cronograma-list');
  if(!moduleEtapasDraft.length){
    el.innerHTML = '<p class="field-hint" style="margin:0 0 10px;">Nenhuma etapa ainda — clique em "+ etapa" para começar.</p>';
    return;
  }
  el.innerHTML = moduleEtapasDraft.map((e, i) => `
    <div class="etapa-row">
      <button type="button" class="etapa-remove-btn" onclick="removeEtapaDraft(${i})" title="Remover etapa" aria-label="Remover etapa">×</button>
      <p class="etapa-row-title">Etapa ${i+1}</p>
      <div class="field"><label>Nome da etapa</label><input type="text" value="${esc(e.nome)}" oninput="updateEtapaDraft(${i},'nome',this.value)" placeholder="Ex.: Levantamento de dados"></div>
      <div class="field-row">
        <div class="field"><label>Início</label><input type="date" value="${esc(e.dataInicio||'')}" oninput="updateEtapaDraft(${i},'dataInicio',this.value)"></div>
        <div class="field"><label>Fim</label><input type="date" value="${esc(e.dataFim||'')}" oninput="updateEtapaDraft(${i},'dataFim',this.value)"></div>
        <div class="field"><label>Status</label><select onchange="updateEtapaDraft(${i},'status',this.value)">
          <option ${e.status==='A iniciar'?'selected':''}>A iniciar</option>
          <option ${e.status==='Em andamento'?'selected':''}>Em andamento</option>
          <option ${e.status==='Concluído'?'selected':''}>Concluído</option>
        </select></div>
      </div>
      ${e.id ? '' : `<p class="field-hint" style="margin:0;">Salve o módulo para poder registrar frequência desta etapa no menu "Frequência".</p>`}
    </div>`).join('');
}
async function toggleFrequencia(etapaId, colabId, current){
  if(!db) return;
  await fetch('api/modulo-frequencia/'+encodeURIComponent(etapaId)+'/'+encodeURIComponent(colabId), {
    method:'PUT', headers:{...authHeaders(), 'Content-Type':'application/json'}, body: JSON.stringify({presente: !current})
  });
  await db.reload('modulo-frequencia');
}
function addEtapaDraft(){
  moduleEtapasDraft.push({ id:null, nome:'', dataInicio:'', dataFim:'', status:'A iniciar' });
  renderModuleCronograma();
}
function removeEtapaDraft(i){
  moduleEtapasDraft.splice(i, 1);
  renderModuleCronograma();
}
function updateEtapaDraft(i, field, value){
  moduleEtapasDraft[i][field] = value;
}
async function saveModule(){
  const nome = document.getElementById('mf-nome').value.trim();
  const temaId = document.getElementById('mf-tema').value;
  if(!nome || !temaId){ toast('Informe tema e nome do módulo'); return; }
  const temCronograma = document.getElementById('mf-tem-cronograma').checked;
  const cargaRaw = document.getElementById('mf-carga').value.trim();
  const data = {
    temaId, nome, etapa: document.getElementById('mf-etapa').value.trim(),
    ordem: parseInt(document.getElementById('mf-ordem').value)||0,
    categoria: document.getElementById('mf-categoria').value,
    status: document.getElementById('mf-status').value,
    descricao: getRichTextHtml('mf-desc'),
    mentor: document.getElementById('mf-mentor').value.trim(),
    formato: document.getElementById('mf-formato').value.trim(),
    publicoAlvo: document.getElementById('mf-publico').value.trim(),
    cargaHoraria: cargaRaw === '' ? null : parseFloat(cargaRaw),
    inicioPrevisto: document.getElementById('mf-inicio').value.trim(),
    linkMaterial: document.getElementById('mf-material').value.trim(),
    temCronograma,
  };
  if(!db){ toast('Banco indisponível'); return; }
  let moduleId = editingModuleId;
  if(moduleId){ await db.doc('modulos/'+moduleId).update(data); }
  else { const ref = await db.collection('modulos').add(data); moduleId = ref.id; }

  if(temCronograma){
    const existentes = moduloEtapas.filter(e=>e.moduloId===moduleId);
    const draftIds = new Set(moduleEtapasDraft.filter(e=>e.id).map(e=>e.id));
    for(const old of existentes){
      if(!draftIds.has(old.id)) await db.doc('modulo-etapas/'+old.id).delete();
    }
    for(let i=0; i<moduleEtapasDraft.length; i++){
      const e = moduleEtapasDraft[i];
      const payload = { moduloId: moduleId, nome: e.nome.trim() || `Etapa ${i+1}`, dataInicio: e.dataInicio||'', dataFim: e.dataFim||'', status: e.status, ordem: i };
      if(e.id) await db.doc('modulo-etapas/'+e.id).update(payload);
      else await db.collection('modulo-etapas').add(payload);
    }
    await db.reload('modulo-frequencia'); // exclusão em cascata de etapas removidas acontece no banco
  }

  await db.reload('temas'); // carga horária do tema é a soma dos módulos — recalculada no servidor a cada leitura
  closeModuleDrawer(); toast('Módulo salvo');
}

