function esc(s){ return (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function norm(s){ return (s ?? '').toString().normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase(); }
