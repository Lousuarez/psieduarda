<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Minha Trilha — Juntos a Distância</title>
<link rel="icon" type="image/png" href="/assets/favicon.png">
<script>
(function(){
  try{
    var t = localStorage.getItem('jad-theme');
    if(t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
  }catch(e){}
})();
function toggleTheme(){
  var root = document.documentElement;
  var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
  var current = root.getAttribute('data-theme');
  var effectiveDark = current === 'dark' || (current !== 'light' && systemDark);
  var next = effectiveDark ? 'light' : 'dark';
  root.setAttribute('data-theme', next);
  try{ localStorage.setItem('jad-theme', next); }catch(e){}
}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#FAFAF8; --bg-elevated:#FFFFFF; --bg-sunken:#F1F0EA; --line:#E5E4DE;
    --ink:#181A16; --ink-dim: rgba(24,26,22,.6); --ink-faint: rgba(24,26,22,.54);
    --verde:#84E115; --verde-ink:#044D41;
    --status-done-bg: var(--verde); --status-done-ink: var(--verde-ink);
    --status-prog-bg:#FCEBC2; --status-prog-ink:#8A5A00;
    --status-todo-bg: var(--line); --status-todo-ink: var(--ink-dim);
    --font:'Urbanist', -apple-system, BlinkMacSystemFont,"Segoe UI",sans-serif;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#0A0F0C; --bg-elevated:#131A15; --bg-sunken:#0E1411; --line: rgba(255,255,255,.10);
      --ink:#F5F7F1; --ink-dim: rgba(245,247,241,.62); --ink-faint: rgba(245,247,241,.42);
      --status-done-bg: rgba(132,225,21,.18); --status-done-ink:#9BE62A;
      --status-prog-bg: rgba(242,176,61,.18); --status-prog-ink:#F2B03D;
      --status-todo-bg: rgba(255,255,255,.07); --status-todo-ink: var(--ink-dim);
    }
  }
  :root[data-theme="dark"]{
    --bg:#0A0F0C; --bg-elevated:#131A15; --bg-sunken:#0E1411; --line: rgba(255,255,255,.10);
    --ink:#F5F7F1; --ink-dim: rgba(245,247,241,.62); --ink-faint: rgba(245,247,241,.42);
    --status-done-bg: rgba(132,225,21,.18); --status-done-ink:#9BE62A;
    --status-prog-bg: rgba(242,176,61,.18); --status-prog-ink:#F2B03D;
    --status-todo-bg: rgba(255,255,255,.07); --status-todo-ink: var(--ink-dim);
  }
  *{ box-sizing:border-box; }
  body{ margin:0; background:var(--bg); color:var(--ink); font-family:var(--font); min-height:100vh; }
  .wrap{ max-width:640px; margin:0 auto; padding:28px 18px 60px; }
  .top-row{ display:flex; justify-content:space-between; align-items:center; margin-bottom:22px; }
  .brand{ font-size:12px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; color:var(--ink-dim); }
  .theme-toggle{ appearance:none; background:var(--bg-elevated); border:1px solid var(--line); border-radius:8px; width:32px; height:32px; display:flex; align-items:center; justify-content:center; cursor:pointer; color:var(--ink-dim); padding:0; }
  .theme-toggle svg{ width:16px; height:16px; }
  .theme-toggle .theme-icon-sun{ display:none; }
  .theme-toggle .theme-icon-moon{ display:block; }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]) .theme-toggle .theme-icon-sun{ display:block; }
    :root:not([data-theme="light"]) .theme-toggle .theme-icon-moon{ display:none; }
  }
  :root[data-theme="dark"] .theme-toggle .theme-icon-sun{ display:block; }
  :root[data-theme="dark"] .theme-toggle .theme-icon-moon{ display:none; }

  .card{ background:var(--bg-elevated); border:1px solid var(--line); border-radius:14px; padding:22px; }
  h1{ font-size:20px; font-weight:800; margin:0 0 6px; }
  .badges{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:4px; }
  .badge{ font-size:10.5px; font-weight:800; letter-spacing:.03em; text-transform:uppercase; padding:4px 10px; border-radius:20px; background:var(--bg-sunken); color:var(--ink-dim); }
  .badge.lideranca{ background:var(--status-done-bg); color:var(--status-done-ink); }

  .section-h{ font-weight:700; font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-dim); margin:24px 0 10px; }
  .progress-group{ margin-bottom:22px; }
  .progress-group-title{ font-size:13px; font-weight:800; color:var(--ink); margin-bottom:8px; }
  .progress-group-stat-row{ display:flex; align-items:baseline; gap:8px; margin-bottom:8px; }
  .progress-group-stat-num{ font-size:22px; font-weight:800; color:var(--verde-ink); line-height:1; }
  @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .progress-group-stat-num{ color:var(--verde); } }
  :root[data-theme="dark"] .progress-group-stat-num{ color:var(--verde); }
  .progress-group-stat-label{ font-size:11.5px; font-weight:600; color:var(--ink-dim); }
  .progress-bar-outer{ height:5px; border-radius:4px; background:var(--status-todo-bg); overflow:hidden; margin-bottom:22px; }
  .progress-bar-inner{ height:100%; background:var(--verde); border-radius:4px; }

  .progress-cycle-card{ border:1px solid var(--line); border-radius:10px; padding:12px 14px; margin-bottom:10px; background:var(--bg-sunken); }
  .progress-cycle-head{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .progress-cycle-title{ font-size:11px; font-weight:700; color:var(--verde-ink); text-transform:uppercase; letter-spacing:.04em; }
  @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .progress-cycle-title{ color:var(--verde); } }
  :root[data-theme="dark"] .progress-cycle-title{ color:var(--verde); }
  .progress-cycle-count{ font-size:11px; font-weight:700; color:var(--ink-dim); white-space:nowrap; }
  .prog-list{ margin-top:10px; }
  .prog-row{ display:flex; align-items:center; gap:8px; padding:6px 0; }
  .prog-name{ flex:1; min-width:0; font-size:12.5px; font-weight:600; color:var(--ink); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .status-dot{ width:7px; height:7px; border-radius:50%; flex-shrink:0; }
  .status-dot.done{ background:var(--status-done-ink); }
  .status-dot.on{ background:var(--status-prog-ink); }
  .status-dot.off{ background:var(--status-todo-ink); }
  .status-pill{ font-size:8.5px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; padding:3px 8px; border-radius:20px; white-space:nowrap; }
  .status-pill.done{ background:var(--status-done-bg); color:var(--status-done-ink); }
  .status-pill.on{ background:var(--status-prog-bg); color:var(--status-prog-ink); }
  .status-pill.off{ background:var(--status-todo-bg); color:var(--status-todo-ink); }

  .empty-state{ padding:40px 10px; text-align:center; color:var(--ink-dim); font-size:13px; }
  .foot-note{ text-align:center; font-size:11px; color:var(--ink-faint); margin-top:24px; }
</style>
</head>
<body>
  <div class="wrap">
    <div class="top-row">
      <span class="brand">Juntos a Distância</span>
      <button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Alternar tema claro/escuro" title="Alternar tema claro/escuro">
        <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>
      </button>
    </div>
    <div class="card" id="content">
      <div class="empty-state">Carregando…</div>
    </div>
    <p class="foot-note">Este link é pessoal — não compartilhe.</p>
  </div>

<script>
function esc(s){ return (s ?? '').toString().replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function statusClass(st){ if(st==='Concluído') return 'done'; if(st==='Em andamento') return 'on'; return 'off'; }

async function boot(){
  const token = location.pathname.split('/').filter(Boolean).pop();
  const el = document.getElementById('content');
  try{
    const res = await fetch('/api/minha-trilha/' + encodeURIComponent(token));
    if(!res.ok){
      el.innerHTML = '<div class="empty-state">Link inválido ou expirado. Peça um novo link para o administrador.</div>';
      return;
    }
    const data = await res.json();
    render(data);
  }catch(e){
    el.innerHTML = '<div class="empty-state">Não foi possível carregar seus dados agora. Tente novamente em instantes.</div>';
  }
}

function render(data){
  const el = document.getElementById('content');
  let html = `<h1>${esc(data.nome)}</h1>
    <div class="badges">
      ${data.lideranca ? '<span class="badge lideranca">Liderança</span>' : ''}
      ${data.unidade ? `<span class="badge">${esc(data.unidade)}</span>` : ''}
      ${data.cargo ? `<span class="badge">${esc(data.cargo)}</span>` : ''}
    </div>`;

  if(!data.trilhas.length){
    html += '<div class="empty-state">Você ainda não está matriculado em nenhuma trilha.</div>';
    el.innerHTML = html;
    return;
  }

  html += '<div class="section-h">Minhas trilhas</div>';
  data.trilhas.forEach(t => {
    const mods = t.ciclos.flatMap(ci => ci.modulos);
    const done = mods.filter(m => m.status === 'Concluído').length;
    const pct = mods.length ? Math.round(done / mods.length * 100) : 0;
    html += `<div class="progress-group">
      <div class="progress-group-title">${esc(t.nome)}</div>
      <div class="progress-group-stat-row">
        <span class="progress-group-stat-num">${pct}%</span>
        <span class="progress-group-stat-label">${done}/${mods.length} módulos concluídos</span>
      </div>
      <div class="progress-bar-outer"><div class="progress-bar-inner" style="width:${pct}%"></div></div>`;
    t.ciclos.forEach(ci => {
      if(!ci.modulos.length) return;
      const doneCi = ci.modulos.filter(m => m.status === 'Concluído').length;
      html += `<div class="progress-cycle-card">
        <div class="progress-cycle-head">
          <span class="progress-cycle-title">${esc(ci.nome)}</span>
          <span class="progress-cycle-count">${doneCi}/${ci.modulos.length}</span>
        </div>
        <div class="prog-list">`;
      ci.modulos.forEach(m => {
        const cls = statusClass(m.status);
        html += `<div class="prog-row"><span class="status-dot ${cls}"></span><span class="prog-name">${esc(m.nome)}</span>
          <span class="status-pill ${cls}">${esc(m.status)}</span></div>`;
      });
      html += `</div></div>`;
    });
    html += `</div>`;
  });
  el.innerHTML = html;
}

boot();
</script>
</body>
</html>
